# PrescribeMe - Environment variables
# Copy to .env and fill in your keys.

OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Chroma persistence path (default: ./chroma_db)
# CHROMA_PERSIST_DIR=./chroma_db

# Production: comma-separated frontend URLs allowed by CORS (e.g. your Vercel URL)
# CORS_ORIGINS=https://prescribeme.vercel.app,https://your-app.vercel.app
