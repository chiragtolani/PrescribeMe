# PrescribeMe - Environment variables
# Copy to .env and fill in your keys. Never commit .env or log API keys.

OPENAI_API_KEY=sk-your-openai-api-key-here

# LLM (optional overrides)
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SEC=60
# LLM_MAX_RETRIES=3
# LLM_MAX_TOKENS=2048

# Input limits (chars) — prescription and patient context
# MAX_PRESCRIPTION_LENGTH=2000
# MAX_PATIENT_CONTEXT_LENGTH=1000

# Analyze response cache (reduces duplicate LLM calls; set 0 to disable)
# ENABLE_ANALYZE_CACHE=1
# ANALYZE_CACHE_MAX_ENTRIES=100

# Chroma: local (default) or Chroma Cloud
# For local: leave CHROMA_TENANT unset (uses PersistentClient, stores in ./chroma_db)
# Optional: Chroma persistence path (local mode only, default: ./chroma_db)
# CHROMA_PERSIST_DIR=./chroma_db

# Chroma Cloud (production): use CloudClient with tenant + database
# CHROMA_API_KEY=your-chroma-cloud-api-key
# CHROMA_TENANT=your-tenant-uuid
# CHROMA_DATABASE=drugs-database

# Production: comma-separated frontend URLs allowed by CORS (e.g. your Vercel URL)
# CORS_ORIGINS=https://prescribeme.vercel.app,https://your-app.vercel.app
